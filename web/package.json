{
  "name": "farmlife",
  "version": "5.5.4",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .js,.jsx,.mjs",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .js,.jsx,.mjs --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,mjs,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,mjs,css,json}\"",
    "qa:full": "npm run lint && npm run test && npm run build",
    "smoke-test": "vitest --run src/test/smoke.test.jsx"
  },
  "dependencies": {
    "lucide-react": "^0.539.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "autoprefixer": "^10.4.0",
    "c8": "^8.0.1",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.3.0",
    "vite": "^4.0.0",
    "vitest": "^0.34.6"
  }
}
