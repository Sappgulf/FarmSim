{
  "name": "farmsim-monorepo",
  "private": true,
  "description": "Tooling and scripts for web + ios. Install and run the app from web/: npm --prefix web install && npm run dev",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "test": "npm --prefix web run test",
    "test:ui": "npm --prefix web run test:ui",
    "test:coverage": "npm --prefix web run test:coverage",
    "test:watch": "npm --prefix web run test:watch",
    "lint": "npm --prefix web run lint",
    "qa:full": "npm --prefix web run qa:full",
    "test:e2e": "npm --prefix web run test:e2e",
    "smoke-test": "npm --prefix web run smoke-test",
    "install:web": "npm --prefix web install",
    "ios:gen": "make -C ios ios-gen",
    "ios:build": "make -C ios ios-build",
    "ios:build:small": "make -C ios ios-build-small",
    "ios:build:large": "make -C ios ios-build-large",
    "ios:test:core": "swift test --package-path ios/GameCore",
    "sora:prompts": "node scripts/sora/build-icon-prompts.mjs",
    "agents:run": "bash scripts/subagents/run-parallel.sh",
    "agents:status": "bash scripts/subagents/status.sh",
    "agents:cleanup": "bash scripts/subagents/cleanup.sh"
  }
}
