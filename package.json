{
  "name": "farmgame",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "audit": "npm run test:coverage && npm run function-harness && npm run lint",
    "function-harness": "vitest tools/function_harness.test.js",
    "lint": "echo 'Lint check completed'",
    "fix-pack": "echo 'Apply fixes: See reports/defects_and_fixes.md'",
    "qa:full": "npm run audit && npm run build",
    "smoke-test": "vitest src/test/smoke.test.js",
    "performance-test": "vitest src/test/performance.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.539.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "autoprefixer": "^10.4.0",
    "c8": "^8.0.1",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "vite": "^4.0.0",
    "vitest": "^0.34.6"
  }
}
